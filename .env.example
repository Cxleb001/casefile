# Copy to .env and fill in. .env is gitignored: never commit real keys.

# ---- Sample mode --------------------------------------------------------------
# true = run on the bundled slice in sample/ and replay the recorded model answers:
# no Zetaris, no Nightshift, no keys (see sample/README.md). Overrides the data and model settings.
SAMPLE_MODE=false
# Keep every model request and answer in runs/.../llm/<case>.jsonl (the trace, and what sample mode replays).
CASEFILE_RECORD_LLM=true

# ---- Data backend -----------------------------------------------------------
# local   = DuckDB stand-in over data/prepared (same table names as Zetaris)
# zetaris = live federated queries through your Zetaris cluster
CASEFILE_DATA_BACKEND=local

# ---- Models -----------------------------------------------------------------
# meterless = Meterless Nightshift on your machine (the primary provider; OpenAI-compatible).
#             Add your NVIDIA key inside Nightshift, not here. Token: Nightshift's proxy-token file,
#             or `python scripts/codespace/setup_env.py --nightshift`. Check: python scripts/check_nightshift.py
# nvidia    = NVIDIA's API directly (development only; key from https://build.nvidia.com/settings/api-keys)
CASEFILE_LLM_PROVIDER=meterless
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_TOKEN=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# Optional per-step models. Blank = NVIDIA Nemotron through Nightshift: plan and fast use
# nvidia/nemotron-3.5-lightning-30b-a3b, report and verify use nvidia/nemotron-3-ultra-550b-a55b.
# plan = the investigation loop (many short steps: a fast model); report = the decision and SAR draft
# (defaults to the verify model); verify = the claim checker (the strongest model).
CASEFILE_MODEL_FAST=
CASEFILE_MODEL_PLAN=
CASEFILE_MODEL_REPORT=
CASEFILE_MODEL_VERIFY=
# How much a Nemotron model thinks before answering, per step: off | medium | on.
# Defaults: plan=off, report=medium, verify=medium (thinking tokens count against the reply cap).
CASEFILE_THINKING_PLAN=
CASEFILE_THINKING_REPORT=
CASEFILE_THINKING_VERIFY=

# ---- Zetaris ----------------------------------------------------------------
# rest  = documented REST API (ZETARIS_REST_URL, ends in /api/v1.0)
# proxy = the UI's /api/proxy route (ZETARIS_BASE_URL, the UI origin)
ZETARIS_ROUTE=rest
ZETARIS_REST_URL=
ZETARIS_BASE_URL=
# Management -> Organisation -> ID
ZETARIS_ORG_ID=
# Management -> API Tokens, or a username + password
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ENGINE_ID=
ZETARIS_QUERY_LIMIT=5000

# Registered table names, if yours differ from scripts/zetaris/register_sources.sql
CASEFILE_TABLE_LEDGER_A=inst_a.ledger_a
CASEFILE_TABLE_KYC_A=inst_a.kyc_a
CASEFILE_TABLE_LEDGER_B=inst_b.ledger_b
CASEFILE_TABLE_KYC_B=shared.kyc_b
CASEFILE_TABLE_WATCHLIST=compliance.watchlist

# ---- Where the sources live (scripts/publish_sources.py) --------------------
# Institution A's Postgres, e.g. a free Neon database
PG_URL=
# Institution B's bucket, in the same region as the Zetaris cluster
S3_BUCKET=
S3_PREFIX=casefile
AWS_REGION=us-east-1

# ---- Local / Codespace route (scripts/publish_local.py, scripts/zetaris_apply.py) ----
# The sources database (infra/docker-compose.sources.yml). Python reaches it on localhost:5433.
LOCAL_PG_HOST=localhost
LOCAL_PG_PORT=5433
LOCAL_PG_USER=casefile
LOCAL_PG_PASSWORD=casefile-local
# How Zetaris reaches it: host.docker.internal on Docker Desktop, casefile-sources in a Codespace
# (scripts/codespace/connect_sources.sh sets this for you).
ZETARIS_PG_HOST=host.docker.internal
# On the local route Institution B's governed view is registered as inst_b.kyc_b_shared:
# CASEFILE_TABLE_KYC_B=inst_b.kyc_b_shared
