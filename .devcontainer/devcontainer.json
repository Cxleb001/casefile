{
  "name": "Casefile + Zetaris",
  "image": "mcr.microsoft.com/devcontainers/universal:6-noble",
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "forwardPorts": [8501, 3000],
  "portsAttributes": {
    "8501": { "label": "Casefile app", "onAutoForward": "notify" },
    "3000": { "label": "Zetaris UI", "onAutoForward": "silent" }
  },
  "postCreateCommand": "python3 -m venv --clear .venv && .venv/bin/pip install -q -r requirements.txt -r requirements-ui.txt kaggle && cp -n .env.example .env",
  "customizations": {
    "vscode": {
      "settings": { "python.defaultInterpreterPath": ".venv/bin/python", "python.terminal.activateEnvironment": true },
      "extensions": ["ms-python.python"]
    }
  }
}
